{
  "nombre": "previ_transporte",
  "descripcion": "Prevision de costes de transporte al cierre, tal como la exporta el TMS, para saber cuanto va a costar el transporte del periodo antes de recibir las facturas y poder repartirlo por delegacion y cliente. Cada fila es un albaran con su coste ventilado, su transportista y la unidad de gestion a la que se imputa. El fichero llega como foto completa: cada exportacion sustituye entera a la anterior, por eso la singularidad es origen_carga y no una clave de negocio -- no se acumula historico por recarga. De aqui salen el resumen por delegacion y el detalle en CSV que se usan aguas abajo. Desconfia si el numero de filas cae mucho respecto al cierre anterior: suele significar que la exportacion salio incompleta.",
  "carpeta": "entrada/previ_transporte",
  "patron": "*.xlsx",
  "formato": "excel",
  "hoja": "Ficheros Previ a subir",
  "fila_cabecera": 1,
  "tabla_destino": "previ_transporte",
  "mapping": [
    {
      "origen": "CODIGO_UT",
      "destino": "codigo_ut",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "TRANSPORTISTA",
      "destino": "transportista",
      "operaciones": [
        {
          "tipo": "trim"
        }
      ]
    },
    {
      "origen": "ORACLE_CARRIER_ID",
      "destino": "oracle_carrier_id",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "ORACLE_CARRIER_SITE",
      "destino": "oracle_carrier_site",
      "operaciones": [
        {
          "tipo": "trim"
        }
      ]
    },
    {
      "origen": "COSTE_VENTILADO",
      "destino": "coste_ventilado",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "double"
        }
      ]
    },
    {
      "origen": "CODIGO_DT",
      "destino": "codigo_dt",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "ALBARAN",
      "destino": "albaran",
      "operaciones": [
        {
          "tipo": "trim"
        }
      ]
    },
    {
      "origen": "MANAGEMENT_UNIT",
      "destino": "management_unit",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "DESCARGA_COMIENZO",
      "destino": "descarga_comienzo",
      "operaciones": [
        {
          "tipo": "date_format",
          "formatos": [
            "%Y%m%d%H%M%S"
          ]
        }
      ]
    },
    {
      "origen": "NOMBRE_CLIENTE",
      "destino": "nombre_cliente",
      "operaciones": [
        {
          "tipo": "trim"
        }
      ]
    },
    {
      "origen": "CONTRATO_ORACLE",
      "destino": "contrato_oracle",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "DELEG_NOMBRE",
      "destino": "deleg_nombre",
      "operaciones": [
        {
          "tipo": "trim"
        }
      ]
    },
    {
      "origen": "PRIME",
      "destino": "prime",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "AÑO",
      "destino": "anio",
      "operaciones": [
        {
          "tipo": "cast",
          "tipo_destino": "integer"
        }
      ]
    },
    {
      "origen": "MES",
      "destino": "mes",
      "operaciones": [
        {
          "tipo": "trim"
        }
      ]
    },
    {
      "destino": "origen_carga",
      "operaciones": [
        {
          "tipo": "const",
          "valor": "previ_transporte"
        }
      ]
    }
  ],
  "campos_singularidad": [
    "origen_carga"
  ],
  "salidas": [
    {
      "nombre": "resumen_delegacion",
      "fichero": "%Y%m%d_previ_ok.xlsx",
      "sql": "SELECT deleg_nombre, anio, mes, count(*) AS lineas, round(sum(coste_ventilado),2) AS coste FROM previ_transporte WHERE anio IS NOT NULL GROUP BY 1,2,3 ORDER BY 1,2,3"
    },
    {
      "nombre": "detalle_csv",
      "fichero": "%Y%m%d_previ_detalle_{ejecucion_id}.csv",
      "sql": "SELECT codigo_ut, transportista, nombre_cliente, deleg_nombre, anio, mes, coste_ventilado FROM previ_transporte WHERE anio IS NOT NULL"
    }
  ]
}