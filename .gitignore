/datos/*.duckdb
/datos/*.duckdb.wal
# Documentos archivados: extractos, facturas y justificantes de clientes.
# Nunca deben acabar en el repo.
/datos/documentos/**
/export/*
!/export/.gitkeep
/entrada/**
!/entrada/.gitkeep
!/entrada/*/
!/entrada/**/.gitkeep
__pycache__/
*.pyc
.venv/
# Capa propia: cargas, catálogo y migraciones de cada instalación.
# Es su propio repositorio git, privado. Nunca sale del repo público.
/propio/**

# Configuracion de esta maquina: donde viven el almacen, los documentos
# y las exportaciones. La escribe `db init`.
config.local.json
